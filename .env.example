# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin
NEXT_PUBLIC_SITE_URL=https://peaktrekker.cc

# Admin / QA access
ADMIN_EMAILS=
COMMUNITY_TEST_ADMIN_EMAIL=
ONBOARDING_ADMIN_EMAILS=

# QA helper switches
ENABLE_QA_TEST_HELPERS=
NEXT_PUBLIC_ENABLE_QA_TEST_HELPERS=

# Trek session config
# Allow client-generated local sessions (for QA / e2e testing only)
# MUST be unset or "false" in production
ALLOW_LOCAL_TREK_SESSION=

# Weather API
QWEATHER_API_KEY=
# Optional: Cron secret for batch refresh
WEATHER_REFRESH_SECRET=
# Local target for the one-time prelaunch refresh driver (for example http://127.0.0.1:8787)
BASE_URL=

# MiMo v2.5 multimodal screenshot text recognition
MIMO_API_KEY=

# Monetization
# Enable premium template paywall (default: false for beta period)
ENABLE_PREMIUM_TEMPLATE_PAYWALL=

# Playwright
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100
