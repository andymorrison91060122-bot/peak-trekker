# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# runtime upload artifacts should live in Supabase Storage
/public/checkin-photos/
/public/avatars/
/public/fonts/*.otf

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.n1b-tmp

# Supabase local init artifacts
supabase/.branches/
supabase/.temp/
supabase/config.toml

# Codex/agent skill cache
.agents/
design-system.zip

# Local-only import test samples (personal GPS data, never commit)
peak-trekker-import-samples/

# Local-only screenshot OCR fixtures (personal activity screenshots, never commit raw images)
爬山轨迹结果参考图片/
