{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peak-trekker.t13-summit-target-proposal.schema.json",
  "title": "T13 summit target proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "effective_canonical_key",
    "proposal_status",
    "effective_sidecar_eligible",
    "proposed_target_role",
    "proposed_target_name",
    "evidence",
    "review"
  ],
  "properties": {
    "schema_version": { "const": "t13-summit-target-proposal-v1" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "effective_canonical_key": { "type": "string", "minLength": 1 },
    "proposal_status": { "const": "pending_review" },
    "effective_sidecar_eligible": { "const": false },
    "proposed_target_role": {
      "enum": ["independent_summit", "representative_highpoint"]
    },
    "proposed_target_name": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak_feature",
        "name_match",
        "elevation_match",
        "sanity_gates",
        "provenance_ids"
      ],
      "properties": {
        "peak_feature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_family",
            "source_feature_id",
            "natural",
            "datum",
            "latitude",
            "longitude"
          ],
          "properties": {
            "source_family": { "type": "string", "minLength": 1 },
            "source_feature_id": { "type": "string", "minLength": 1 },
            "natural": { "const": "peak" },
            "datum": { "const": "WGS-84" },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "name_match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "match_type", "candidate_name", "matched_ledger_name", "source_name_fields"],
          "properties": {
            "passed": { "const": true },
            "match_type": { "enum": ["exact_normalized", "alias_normalized"] },
            "candidate_name": { "type": "string", "minLength": 1 },
            "matched_ledger_name": { "type": "string", "minLength": 1 },
            "source_name_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "elevation_match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "ledger_altitude_m", "source_altitude_m", "delta_m", "tolerance_m"],
          "properties": {
            "passed": { "const": true },
            "ledger_altitude_m": { "type": "number" },
            "source_altitude_m": { "type": "number" },
            "delta_m": { "type": "number", "minimum": 0 },
            "tolerance_m": {
              "type": "number",
              "enum": [100, 150, 250, 400],
              "$comment": "Executable validation derives the one allowed value from the frozen ledger altitude; this field is never trusted."
            }
          }
        },
        "sanity_gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "province_bbox_sanity",
            "elevation_sanity",
            "seed_displacement_sanity",
            "dem_local_maximum_sanity"
          ],
          "properties": {
            "province_bbox_sanity": { "$ref": "peak-trekker.t13-coordinate-sidecar.schema.json#/$defs/sanity" },
            "elevation_sanity": { "$ref": "peak-trekker.t13-coordinate-sidecar.schema.json#/$defs/sanity" },
            "seed_displacement_sanity": { "$ref": "peak-trekker.t13-coordinate-sidecar.schema.json#/$defs/sanity" },
            "dem_local_maximum_sanity": { "$ref": "peak-trekker.t13-coordinate-sidecar.schema.json#/$defs/sanity" }
          }
        },
        "provenance_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review_artifact_id", "reviewed_at"],
      "properties": {
        "status": { "const": "pending" },
        "review_artifact_id": { "type": "null" },
        "reviewed_at": { "type": "null" }
      }
    }
  }
}
