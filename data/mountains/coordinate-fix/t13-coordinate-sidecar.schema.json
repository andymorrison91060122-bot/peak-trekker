{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peak-trekker.t13-coordinate-sidecar.schema.json",
  "title": "T13 coordinate sidecar record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "effective_canonical_key",
    "catalog_coordinate",
    "summit_coordinate"
  ],
  "properties": {
    "schema_version": { "const": "t13-coordinate-sidecar-v1" },
    "effective_canonical_key": { "type": "string", "minLength": 1 },
    "primary_name": { "type": "string", "minLength": 1 },
    "catalog_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "latitude_literal",
        "longitude_literal",
        "datum",
        "precision_decimals",
        "source_class",
        "provenance_ids",
        "source_binding",
        "status",
        "notes"
      ],
      "properties": {
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "latitude_literal": { "type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]+$" },
        "longitude_literal": { "type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]+$" },
        "datum": { "enum": ["WGS-84", null] },
        "precision_decimals": { "type": ["integer", "null"], "minimum": 0 },
        "source_class": { "type": ["string", "null"] },
        "provenance_ids": { "type": "array", "items": { "type": "string" } },
        "source_binding": {
          "anyOf": [
            { "$ref": "#/$defs/catalogSourceBinding" },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["available", "coarse", "missing", "needs_review"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summit_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "supports_summit_verification",
        "latitude",
        "longitude",
        "latitude_literal",
        "longitude_literal",
        "datum",
        "precision_decimals",
        "target_role",
        "query_target",
        "source_votes",
        "independent_source_count",
        "best_pair_distance_m",
        "province_bbox_sanity",
        "elevation_sanity",
        "seed_displacement_sanity",
        "dem_local_maximum_sanity",
        "mechanical_evidence_sha256",
        "rejection_reasons"
      ],
      "properties": {
        "status": { "enum": ["resolved", "needs_review", "unresolved", "not_applicable"] },
        "supports_summit_verification": { "type": "boolean" },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "latitude_literal": { "type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]+$" },
        "longitude_literal": { "type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]+$" },
        "datum": { "enum": ["WGS-84", null] },
        "precision_decimals": { "type": ["integer", "null"], "minimum": 0 },
        "target_role": {
          "enum": [
            "independent_summit",
            "representative_highpoint",
            "route_highpoint",
            "none"
          ]
        },
        "query_target": {
          "anyOf": [
            { "$ref": "#/$defs/queryTarget" },
            { "type": "null" }
          ]
        },
        "source_votes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "source_family",
              "source_lineage",
              "source_id",
              "datum",
              "latitude",
              "longitude"
              ,"latitude_literal"
              ,"longitude_literal"
            ],
            "properties": {
              "source_family": { "type": "string" },
              "source_lineage": { "type": "string", "minLength": 1 },
              "source_id": { "type": "string" },
              "datum": { "const": "WGS-84" },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
              ,"latitude_literal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]+$" }
              ,"longitude_literal": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]+$" }
            }
          }
        },
        "independent_source_count": { "type": "integer", "minimum": 0 },
        "best_pair_distance_m": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 150,
          "$comment": "Executable validation must recompute this value from different-lineage source_votes using Haversine; this field is never trusted."
        },
        "province_bbox_sanity": { "$ref": "#/$defs/sanity" },
        "elevation_sanity": { "$ref": "#/$defs/sanity" },
        "seed_displacement_sanity": { "$ref": "#/$defs/sanity" },
        "dem_local_maximum_sanity": { "$ref": "#/$defs/sanity" },
        "mechanical_evidence_sha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "rejection_reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "summit_coordinate": {
            "type": "object",
            "properties": { "status": { "const": "resolved" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "summit_coordinate": {
            "type": "object",
            "properties": {
              "supports_summit_verification": { "const": true },
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "latitude_literal": { "type": "string" },
              "longitude_literal": { "type": "string" },
              "datum": { "const": "WGS-84" },
              "precision_decimals": { "type": "integer", "minimum": 4 },
              "target_role": { "enum": ["independent_summit", "representative_highpoint"] },
              "query_target": {
                "type": "object",
                "properties": {
                  "kind": { "enum": ["existing_semantic_target", "reviewed_semantic_override"] }
                }
              },
              "source_votes": { "type": "array", "minItems": 2 },
              "independent_source_count": { "type": "integer", "minimum": 2 },
              "best_pair_distance_m": { "type": "number" },
              "province_bbox_sanity": {
                "type": "object",
                "properties": { "status": { "const": "passed" } }
              },
              "elevation_sanity": {
                "type": "object",
                "properties": { "status": { "const": "passed" } }
              },
              "seed_displacement_sanity": {
                "type": "object",
                "properties": { "status": { "const": "passed" } }
              },
              "dem_local_maximum_sanity": {
                "type": "object",
                "properties": { "status": { "const": "passed" } }
              },
              "mechanical_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "summit_coordinate": {
            "type": "object",
            "properties": {
              "target_role": { "enum": ["none", "route_highpoint"] }
            },
            "required": ["target_role"]
          }
        }
      },
      "then": {
        "properties": {
          "summit_coordinate": {
            "type": "object",
            "properties": {
              "supports_summit_verification": { "const": false },
              "latitude": { "type": "null" },
              "longitude": { "type": "null" },
              "latitude_literal": { "type": "null" },
              "longitude_literal": { "type": "null" },
              "datum": { "type": "null" },
              "precision_decimals": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "summit_coordinate": {
            "type": "object",
            "properties": {
              "status": { "enum": ["needs_review", "unresolved", "not_applicable"] }
            },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "summit_coordinate": {
            "type": "object",
            "properties": {
              "supports_summit_verification": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "catalogSourceBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source_family", "source_id"],
          "properties": {
            "kind": { "const": "provider_feature" },
            "source_family": { "type": "string", "minLength": 1 },
            "source_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ledger_record_sha256"],
          "properties": {
            "kind": { "const": "frozen_ledger_gps_raw" },
            "ledger_record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "queryTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "names", "semantic_source_id"],
          "properties": {
            "kind": { "const": "existing_semantic_target" },
            "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "semantic_source_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "names",
            "semantic_source_id",
            "review_status",
            "review_artifact_id",
            "proposal_id",
            "proposal_sha256"
          ],
          "properties": {
            "kind": { "const": "reviewed_semantic_override" },
            "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "semantic_source_id": { "type": "string", "minLength": 1 },
            "review_status": { "const": "approved" },
            "review_artifact_id": { "type": "string", "minLength": 1 },
            "proposal_id": { "type": "string", "minLength": 1 },
            "proposal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "names"],
          "properties": {
            "kind": { "const": "not_applicable" },
            "names": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    },
    "sanity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "details"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "inconclusive", "not_applicable", "not_run"]
        },
        "details": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
