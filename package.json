{
  "name": "peak-trekker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/download-fonts.js",
    "dev": "next dev",
    "prebuild": "node scripts/download-fonts.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "fonts:download": "node scripts/download-fonts.js",
    "maps": "node scripts/maps/maps.mjs",
    "test:screenshot-route-focus": "node --test --experimental-strip-types tests/screenshot-route-initial-focus.test.ts",
    "test:profile-nickname": "node --test --experimental-strip-types tests/profile-nickname.test.ts tests/profile-nickname-route.test.ts tests/profile-nickname-ui-static.test.ts tests/register-static.test.ts tests/profile-trigger-migration.test.ts",
    "test:trek-offline": "node --test --experimental-strip-types tests/trek-utils.test.ts tests/trek-track-metrics.test.ts tests/trek-append-rpc-static.test.ts tests/trek-stability-static.test.ts",
    "test:field-policy": "node --test --experimental-strip-types tests/activity-field-policy.test.ts tests/share-render-api.test.ts tests/import-parser.test.ts tests/share-track-preview.test.ts && npm run test:field-policy-static",
    "test:field-policy-static": "! rg -q 'EditPencil|aria-label=.*编辑' 'src/app/(flow)/screenshot/' 'src/app/(flow)/share/'",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:upload": "opennextjs-cloudflare upload",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.18.1",
    "@protomaps/basemaps": "^5.7.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.0",
    "exifr": "^7.1.3",
    "fit-file-parser": "^3.0.0",
    "gsap": "^3.15.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.1.6",
    "pmtiles": "^4.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "satori": "^0.26.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
